generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  RESTAURANT_OWNER
  MANAGER
  WAITER
  KITCHEN
  CASHIER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  SERVED
  CLOSED
  REJECTED
  CANCELLED
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  PAY_AT_COUNTER
  PAY_WAITER
  OTHER
  CHAPA
  TELEBIRR
}

enum RecordedPaymentStatus {
  SUCCEEDED
  REFUNDED
  VOIDED
}

enum AssistanceKind {
  WAITER
  BILL
  HELP
}

enum AssistanceStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Restaurant {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  contactPhone       String?
  websiteUrl         String?
  slug               String              @unique
  status             AccountStatus       @default(ACTIVE)
  currency           String              @default("ETB") @db.Char(3)
  timezone           String              @default("Africa/Addis_Ababa")
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  branches           Branch[]
  memberships        Membership[]
  tables             DiningTable[]
  sessions           StaffSession[]
  categories         MenuCategory[]
  items              MenuItem[]
  tableSessions      TableSession[]
  orders             CustomerOrder[]
  assistanceRequests AssistanceRequest[]
  payments           Payment[]

  @@index([status, createdAt])
}

model Branch {
  id                 String                       @id @default(cuid())
  restaurantId       String
  name               String
  slug               String
  address            String?
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  memberships        Membership[]
  operatingHours     BranchOperatingHour[]
  tables             DiningTable[]
  items              MenuItemBranchAvailability[]
  tableSessions      TableSession[]
  orders             CustomerOrder[]
  assistanceRequests AssistanceRequest[]
  payments           Payment[]

  @@unique([restaurantId, slug])
  @@unique([id, restaurantId])
  @@index([restaurantId, isActive])
}

model BranchOperatingHour {
  id        String  @id @default(cuid())
  branchId  String
  dayOfWeek Int
  opensAt   String  @db.VarChar(5)
  closesAt  String  @db.VarChar(5)
  isClosed  Boolean @default(false)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  displayName               String
  passwordHash              String
  isPlatformAdmin           Boolean                  @default(false)
  isActive                  Boolean                  @default(true)
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(3)
  memberships               Membership[]
  sessions                  StaffSession[]
  orderEvents               OrderEvent[]             @relation("OrderEventActor")
  assistanceEvents          AssistanceRequestEvent[] @relation("AssistanceEventActor")
  handledAssistanceRequests AssistanceRequest[]
  kitchenItemEvents         KitchenItemEvent[]       @relation("KitchenItemEventActor")
  recordedPayments          Payment[]                @relation("PaymentActor")
  paymentAudits             PaymentAudit[]           @relation("PaymentAuditActor")

  @@index([isActive, email])
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  branchId     String?
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch       Branch?    @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([userId, restaurantId, branchId, role])
  @@index([restaurantId, branchId, role, isActive])
  @@index([userId, isActive])
}

model DiningTable {
  id                 String              @id @default(cuid())
  restaurantId       String
  branchId           String
  label              String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  qrTokens           QRToken[]
  tableSessions      TableSession[]
  orders             CustomerOrder[]
  assistanceRequests AssistanceRequest[]

  @@unique([branchId, label])
  @@unique([id, restaurantId, branchId])
  @@index([restaurantId, branchId, isActive])
}

model QRToken {
  id              String      @id @default(cuid())
  restaurantId    String
  branchId        String
  tableId         String
  tokenHash       String      @unique
  tokenCiphertext String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?   @db.Timestamptz(3)
  expiresAt       DateTime?   @db.Timestamptz(3)
  table           DiningTable @relation(fields: [tableId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)

  @@index([restaurantId, branchId, tableId, isActive])
}

model StaffSession {
  id           String      @id @default(cuid())
  userId       String
  restaurantId String?
  tokenHash    String      @unique
  expiresAt    DateTime    @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?   @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([restaurantId, expiresAt])
}

model MenuCategory {
  id           String                    @id @default(cuid())
  publicId     String                    @unique @default(uuid())
  restaurantId String
  name         String
  sortOrder    Int                       @default(0)
  isActive     Boolean                   @default(true)
  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items        MenuItem[]
  translations MenuCategoryTranslation[]

  @@unique([id, restaurantId])
  @@index([restaurantId, isActive, sortOrder])
}

model MenuCategoryTranslation {
  id         String       @id @default(cuid())
  categoryId String
  locale     String       @db.VarChar(8)
  name       String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model MenuItem {
  id                 String                       @id @default(cuid())
  publicId           String                       @unique @default(uuid())
  restaurantId       String
  categoryId         String
  name               String
  description        String?
  ingredients        String?
  allergens          String?
  portionSize        String?
  price              Decimal                      @db.Decimal(12, 2)
  imageUrl           String?
  dietaryLabels      String[]                     @default([])
  spiceLevel         Int?
  isFeatured         Boolean                      @default(false)
  isActive           Boolean                      @default(true)
  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category           MenuCategory                 @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  translations       MenuItemTranslation[]
  branchAvailability MenuItemBranchAvailability[]
  modifierGroups     ModifierGroup[]
  orderItems         CustomerOrderItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId, categoryId, isActive])
}

model MenuItemTranslation {
  id          String   @id @default(cuid())
  itemId      String
  locale      String   @db.VarChar(8)
  name        String
  description String?
  ingredients String?
  allergens   String?
  portionSize String?
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
}

model MenuItemBranchAvailability {
  id           String   @id @default(cuid())
  itemId       String
  restaurantId String
  branchId     String
  isAvailable  Boolean  @default(true)
  item         MenuItem @relation(fields: [itemId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  branch       Branch   @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId, isAvailable])
}

model ModifierGroup {
  id            String                     @id @default(cuid())
  publicId      String                     @unique @default(uuid())
  itemId        String
  name          String
  isRequired    Boolean                    @default(false)
  minSelections Int                        @default(0)
  maxSelections Int                        @default(1)
  sortOrder     Int                        @default(0)
  item          MenuItem                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options       ModifierOption[]
  translations  ModifierGroupTranslation[]

  @@index([itemId, sortOrder])
}

model ModifierGroupTranslation {
  id      String        @id @default(cuid())
  groupId String
  locale  String        @db.VarChar(8)
  name    String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
}

model ModifierOption {
  id           String                      @id @default(cuid())
  publicId     String                      @unique @default(uuid())
  groupId      String
  name         String
  priceDelta   Decimal                     @default(0) @db.Decimal(12, 2)
  isAvailable  Boolean                     @default(true)
  group        ModifierGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  translations ModifierOptionTranslation[]

  @@index([groupId, isAvailable])
}

model ModifierOptionTranslation {
  id       String         @id @default(cuid())
  optionId String
  locale   String         @db.VarChar(8)
  name     String
  option   ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

model TableSession {
  id                 String              @id @default(cuid())
  restaurantId       String
  branchId           String
  tableId            String
  openedAt           DateTime            @default(now()) @db.Timestamptz(3)
  closedAt           DateTime?           @db.Timestamptz(3)
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  table              DiningTable         @relation(fields: [tableId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  orders             CustomerOrder[]
  assistanceRequests AssistanceRequest[]
  payments           Payment[]

  @@unique([id, restaurantId, branchId])
  @@index([tableId, closedAt])
  @@index([restaurantId, branchId, openedAt])
}

model CustomerOrder {
  id                  String              @id @default(cuid())
  reference           String              @unique
  restaurantId        String
  branchId            String
  tableId             String
  tableSessionId      String
  status              OrderStatus         @default(PENDING_CONFIRMATION)
  paymentStatus       PaymentStatus       @default(UNPAID)
  currency            String              @db.Char(3)
  subtotal            Decimal             @db.Decimal(12, 2)
  total               Decimal             @db.Decimal(12, 2)
  note                String?
  idempotencyKey      String              @unique
  guestTokenHash      String
  guestTokenExpiresAt DateTime            @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch              Branch              @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  table               DiningTable         @relation(fields: [tableId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  tableSession        TableSession        @relation(fields: [tableSessionId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  items               CustomerOrderItem[]
  events              OrderEvent[]
  paymentAllocations  PaymentAllocation[]

  @@index([restaurantId, branchId, status, createdAt])
  @@index([tableSessionId, createdAt])
}

model Payment {
  id                   String                @id @default(cuid())
  restaurantId         String
  branchId             String
  tableSessionId       String
  recordedByUserId     String?
  idempotencyKey       String                @unique
  amount               Decimal               @db.Decimal(12, 2)
  currency             String                @db.Char(3)
  method               PaymentMethod
  status               RecordedPaymentStatus @default(SUCCEEDED)
  transactionReference String?
  note                 String?
  providerMetadata     Json?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch               Branch                @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  tableSession         TableSession          @relation(fields: [tableSessionId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  recordedBy           User?                 @relation("PaymentActor", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  allocations          PaymentAllocation[]
  audits               PaymentAudit[]

  @@index([restaurantId, branchId, createdAt])
  @@index([tableSessionId, status, createdAt])
}

model PaymentAllocation {
  id        String        @id @default(cuid())
  paymentId String
  orderId   String
  amount    Decimal       @db.Decimal(12, 2)
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([paymentId, orderId])
  @@index([orderId])
}

model PaymentAudit {
  id          String   @id @default(cuid())
  paymentId   String
  actorUserId String?
  action      String   @db.VarChar(24)
  note        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor       User?    @relation("PaymentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
}

model CustomerOrderItem {
  id                   String             @id @default(cuid())
  orderId              String
  menuItemId           String?
  nameSnapshot         String
  unitPrice            Decimal            @db.Decimal(12, 2)
  quantity             Int
  lineTotal            Decimal            @db.Decimal(12, 2)
  customizations       Json
  specialInstructions  String?
  kitchenStatus        KitchenItemStatus  @default(PENDING)
  preparationStartedAt DateTime?          @db.Timestamptz(3)
  readyAt              DateTime?          @db.Timestamptz(3)
  order                CustomerOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem             MenuItem?          @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  preparationEvents    KitchenItemEvent[]

  @@index([orderId])
}

model KitchenItemEvent {
  id             String             @id @default(cuid())
  orderItemId    String
  previousStatus KitchenItemStatus?
  status         KitchenItemStatus
  staffUserId    String?
  note           String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  orderItem      CustomerOrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  staffUser      User?              @relation("KitchenItemEventActor", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([orderItemId, createdAt])
  @@index([staffUserId, createdAt])
}

model OrderEvent {
  id             String        @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  status         OrderStatus
  staffUserId    String?
  note           String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  order          CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffUser      User?         @relation("OrderEventActor", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([staffUserId, createdAt])
}

model AssistanceRequest {
  id                  String                   @id @default(cuid())
  reference           String?                  @unique
  guestTokenHash      String?
  guestTokenExpiresAt DateTime?                @db.Timestamptz(3)
  restaurantId        String
  branchId            String
  tableId             String
  tableSessionId      String
  kind                AssistanceKind
  status              AssistanceStatus         @default(OPEN)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  handledAt           DateTime?                @db.Timestamptz(3)
  handledByUserId     String?
  restaurant          Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch              Branch                   @relation(fields: [branchId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  table               DiningTable              @relation(fields: [tableId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  tableSession        TableSession             @relation(fields: [tableSessionId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict)
  handledBy           User?                    @relation(fields: [handledByUserId], references: [id], onDelete: SetNull)
  events              AssistanceRequestEvent[]

  @@index([restaurantId, branchId, status, createdAt])
  @@index([tableSessionId, kind, createdAt])
}

model AssistanceRequestEvent {
  id             String            @id @default(cuid())
  requestId      String
  previousStatus AssistanceStatus?
  status         AssistanceStatus
  staffUserId    String?
  note           String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  request        AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  staffUser      User?             @relation("AssistanceEventActor", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([staffUserId, createdAt])
}
